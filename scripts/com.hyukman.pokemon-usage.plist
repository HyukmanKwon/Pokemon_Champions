<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  채용률을 매일 새벽 4시에 받는다.

  거는 법 (한 번만):
      cp scripts/com.hyukman.pokemon-usage.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.hyukman.pokemon-usage.plist

  확인:
      launchctl list | grep pokemon-usage
      tail -f ~/Library/Logs/pokemon-champions/usage.log

  지금 한 번 돌려보기:
      launchctl start com.hyukman.pokemon-usage

  떼는 법:
      launchctl unload ~/Library/LaunchAgents/com.hyukman.pokemon-usage.plist

  ── 왜 cron 이 아닌가 ──
    cron 은 그 시각에 맥이 꺼져 있거나 잠들어 있으면 그날을 건너뛴다.
    launchd 는 StartCalendarInterval 을 놓치면 깨어난 뒤 한 번 돌려준다.
    저쪽 자료가 16일 뒤 사라지므로 "놓치면 그만" 이면 안 된다.

  ── 왜 새벽 4시인가 ──
    게임 쪽이 하루 단위로 갱신되고, 그 시각에는 노트북이 잠들어 있을
    가능성이 높다. 깨어난 뒤 도는 것을 전제로 잡은 시각이라 정확히 4시에
    돌 필요는 없다.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hyukman.pokemon-usage</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/hyukman/Pokemon_Champions/scripts/daily_usage.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- 로그를 덮어쓰지 않고 이어 붙인다. 며칠치를 되짚어야 할 때가 있다. -->
    <key>StandardOutPath</key>
    <string>/Users/hyukman/Library/Logs/pokemon-champions/usage.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hyukman/Library/Logs/pokemon-champions/usage.log</string>

    <!-- 죽어도 다시 안 띄운다. 하루 한 번이면 되는 일이라, 실패하면
         다음 날 --backfill 이 그 구멍을 메운다. KeepAlive 를 켜면
         네트워크가 끊긴 동안 초당 한 번씩 저쪽 서버를 두드린다. -->
    <key>KeepAlive</key>
    <false/>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
