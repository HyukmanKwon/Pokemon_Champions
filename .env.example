# 복사해서 .env 로 쓴다. .env 는 git 에 올라가지 않는다.
#   cp .env.example .env
#
# 기본값은 src/pokemon_champions/config.py 에 있다.

PGHOST=localhost
PGPORT=5432
PGDATABASE=pokemon
PGUSER=hyukman
PGPASSWORD=

# 다른 DB로 시험 구축할 때
# PGDATABASE=pokemon_test

# 도우미(agent/backends). 쓰는 모델의 것만 있으면 된다.
# 로컬 모델(ollama)만 쓸 거면 둘 다 비워도 된다.
OPENAI_API_KEY=
# GEMINI_API_KEY=
